node_modules/
dist/
*.log
.DS_Store
leaderboard.json
# Local persistence DB (npm run server default; prod uses /data/dcc.sqlite)
dcc.sqlite
dcc.sqlite-*

# 3D assets are COMMITTED (all CC0; provenance in ASSETS.md + bundled LICENSE files)
# so cloud builds ship real art. scripts/fetch-assets.sh remains for re-sourcing.

# Builder bridge scratch output (promote keepers into assets/ + ASSETS.md)
public/assets/generated/

# Device-harness CAPTURES (tools/mobileshot.mjs --out ...): thousands of
# multi-megabyte PNGs per round. The probe SCRIPTS in tools/_mobile are
# committed; their output is not.
tools/_mobile/*/
# ...same rule for the competitive-screen probes (tools/_r2_measure.mjs and the
# critic's own): the script is the artifact, the megabytes of PNG are not.
tools/_critic/

# Appearance/perf CAPTURE output (tools/lookshots.mjs, tools/spendab.mjs,
# tools/perfbaseline.mjs, tools/surfacepreview.ts). Same rule as above: the
# harness scripts are committed, the multi-megabyte PNG piles they emit are not.
tools/_look*/
tools/_spend*/
tools/_baseline*/
tools/_surface/
tools/_vr.json
# Paydown round captures (tools/perfbaseline.mjs --out, tools/paydown.mjs,
# tools/staticmatrix.mjs): same rule — harness committed, output not.
tools/_pay*/
# (_abshots also holds the two small JSON receipts ASSET-BUDGET.md quotes;
# same rule as _r2pay below — the numbers are committed, the pictures are not.)
tools/_ab*/*.png
tools/_staticmatrix.png
# r2 paydown captures: same rule again — harness committed, the PNG pile and
# raw logs are not. The small JSON receipts ARE committed; they are the
# evidence the round s numbers were read off.
tools/_r2pay/*.png
tools/_r2pay/*.log
# r3 SPEND captures (tools/_r3look.mjs, tools/_r3dmg.mjs, and the acceptance
# cost harness run per arm): same rule as every round above — the harnesses are
# committed and so are the small JSON/log receipts the numbers were read off,
# but the multi-megabyte PNG piles are not.
tools/_r3look/*.png
tools/_r3cost_*/*.png
# Tutorial r1 captures (tools/_tut_r1.mjs): harness + the report receipt are
# committed; the PNG pile is not (same rule as every probe round above).
tools/_tut_shots/*.png
# Tutorial r15 curriculum captures (tools/_tut_r15_curriculum.mjs): same rule —
# the battery is the artifact, the PNG pile of paused pages is not.
tools/_tut_r15_shots/*.png
# Audio r2 spectrogram/waveform sheets (tools/audio/contactsheet.mjs): 21MB of
# PNG per full run. Same rule as every round above — contactsheet.mjs IS the
# artifact and its descriptors.json is the receipt the distinctness numbers
# were read off, so both are committed; the pictures are not. Use
# `--no-images` when you only want the numbers.
tools/audio/_r2_sheets/**/*.png

# The audition sheet is a 5MB GENERATED page (tools/audio/mk-audition.mjs
# rebuilds it from the clips + descriptors). The generator is the artifact;
# the base64 bundle is not.
tools/audio/_r2_sheets/audition.html
# Clip-prune staging (tools/asset-pipeline/prune-character-clips.mjs writes
# candidate GLBs here before --apply copies them into public/).
tools/_prunestage/

# Tutorial round captures (tools/_tut_shoot_*.mjs, tools/_tut_fix_r2.mjs):
# same rule as every other harness above — the probe scripts are committed,
# the 135 MB of PNGs they photograph are not.
tools/_shots/

# Key-visibility round captures (tools/_key_visible.mjs): same rule as every
# harness above — the probe IS the artifact, its multi-megabyte frames are not.
tools/_keyshots/
